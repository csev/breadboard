{
  "name": "breadboard",
  "version": "0.0.11",
  "description": "Javascript breadboard circuit simulator",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "rm -rf dist && vite build",
    "deploy": "./deploy.sh gh-pages",
    "prerelease": "rm -rf dist && vite build",
    "release": "./deploy.sh production",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "jquery": "^3.7.1",
    "jquery-ui": "^1.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.4.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.1",
    "eslint": "^9.4.0",
    "globals": "^15.3.0",
    "jsdom": "^24.1.3",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "type": "module"
}
